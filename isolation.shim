#include <errno.h>
#include <grp.h>
#include <stdbool.h>
#include <stddef.h>
#include <sys/types.h>
#include <unistd.h>

#include "util.h"
#include "log.h"
#include "isolation.h"
#include "conf.h"

/**
 * isolate_initial() - No-op initial isolation hook
 */
void isolate_initial(void)
{
}

/**
 * isolate_fds() - Close inherited file descriptors
 * @argc:	Argument count
 * @argv:	Command line options, used to locate any descriptor from --fd
 *
 * Return: new fd number for descriptor from --fd, or -1 if not specified
 */
int isolate_fds(int argc, char **argv)
{
	int fd, close_from = STDERR_FILENO + 1;
	long max_fd;

	fd = conf_tap_fd(argc, argv);

	if (fd >= 0) {
		if (fd != close_from &&
		    (dup2(fd, close_from) != close_from || close(fd)))
			die_perror("Could not move --fd descriptor");

		fd = close_from++;
	}

	max_fd = sysconf(_SC_OPEN_MAX);
	if (max_fd < 0)
		max_fd = 1024;

	while (close_from < max_fd)
		close(close_from++);

	return fd;
}

/**
 * isolate_user() - Switch to the requested UID and GID
 * @c:		Execution context
 * @uid:	User ID to run as
 * @gid:	Group ID to run as
 * @use_userns:	Unused
 * @userns:	Unused
 */
void isolate_user(const struct ctx *c, uid_t uid, gid_t gid, bool use_userns,
		  const char *userns)
{
	(void)c;
	(void)use_userns;
	(void)userns;

	if (setgroups(0, NULL)) {
		/* This can fail when CAP_SETGID is unavailable. */
		if (errno != EPERM)
			die_perror("Can't drop supplementary groups");
	}

	if (setgid(gid))
		die_perror("Can't set GID to %u", gid);

	if (setuid(uid))
		die_perror("Can't set UID to %u", uid);
}

/**
 * isolate_prefork() - No-op isolation hook
 * @c:		Execution context
 *
 * Return: always zero
 */
int isolate_prefork(const struct ctx *c)
{
	(void)c;

	return 0;
}

/**
 * isolate_postfork() - No-op isolation hook
 * @c:		Execution context
 */
void isolate_postfork(const struct ctx *c)
{
	(void)c;
}
